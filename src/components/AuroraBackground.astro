---
// Adapted from Aceternity UI's Aurora Background (Manu Arora).
// https://ui.aceternity.com/components/aurora-background
---
<div class="aurora-background" aria-hidden="true" transition:name="aurora-background" transition:persist="aurora-background" transition:animate="none"><div class="aurora-lights"></div></div>
<script is:inline>
  // Keep the same point in the loop when moving between static pages.
  document.querySelector('.aurora-background').style.setProperty('--aurora-delay', `-${Date.now() % 60000}ms`);
</script>
<style is:global>
  body { isolation: isolate; }
  .aurora-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--color-bg);
  }
  .aurora-lights {
    --aurora: repeating-linear-gradient(100deg, #3b82f6 10%, #a5b4fc 15%, #93c5fd 20%, #ddd6fe 25%, #60a5fa 30%);
    --aurora-stripes: repeating-linear-gradient(100deg, #fff 0%, #fff 7%, transparent 10%, transparent 12%, #fff 16%);
    position: absolute;
    inset: -10px;
    background-image: var(--aurora-stripes), var(--aurora);
    background-size: 300%, 200%;
    background-position: 50% 50%, 50% 50%;
    opacity: .5;
    filter: blur(10px) invert(1);
    mask-image: radial-gradient(ellipse at 100% 0%, #000 10%, transparent 70%);
  }
  .aurora-lights::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--aurora-stripes), var(--aurora);
    background-size: 200%, 100%;
    background-position: 50% 50%, 50% 50%;
    mix-blend-mode: difference;
    animation: aurora-flow 60s linear infinite;
    animation-delay: var(--aurora-delay, 0s);
  }
  html[data-theme='dark'] .aurora-lights {
    --aurora-stripes: repeating-linear-gradient(100deg, #000 0%, #000 7%, transparent 10%, transparent 12%, #000 16%);
    filter: blur(10px);
  }
  @keyframes aurora-flow {
    from { background-position: 50% 50%, 50% 50%; }
    to { background-position: 350% 50%, 350% 50%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .aurora-lights::after { animation: none; }
  }
</style>
