---
import {getCollection} from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import FilterBar from '../../components/FilterBar.astro';
import PostCard from '../../components/PostCard.astro';
import {postTags} from '../../data/tags';
const posts=(await getCollection('posts')).sort((a,b)=>a.data.cardOrder-b.data.cardOrder);
---
<SiteLayout section="Posts"><FilterBar tags={postTags}/><div class="post-grid">{posts.map(entry=><PostCard entry={entry}/>)}</div></SiteLayout>
