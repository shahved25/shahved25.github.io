---
import {getCollection,render} from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
export async function getStaticPaths(){return (await getCollection('posts')).map(entry=>({params:{slug:entry.data.slug},props:{entry}}));}
const {entry}=Astro.props;
const {Content}=await render(entry);
---
<ArticleLayout entry={entry}><Content/></ArticleLayout>
